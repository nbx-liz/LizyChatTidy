{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**/*.mjs",
      "scripts/**/*.ts",
      "public/**",
      "tests/**",
      "vite.config.ts",
      "playwright.config.ts",
      "app.html",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  }
}
